page {
  min-height: 100%;
  background: #f5f7fb;
  color: #172033;
  font-size: 28rpx;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
}

.card {
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 30rpx;
  background: #ffffff;
  border: 1rpx solid #e8edf5;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(31, 53, 90, 0.06);
}

.section-title {
  margin: 36rpx 0 20rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: #64748b;
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 92rpx;
  margin: 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.primary-button {
  color: #ffffff;
  background: #2563eb;
}

.secondary-button {
  color: #2563eb;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
}

.danger-button {
  color: #b42318;
  background: #fff1f0;
  border: 1rpx solid #fecaca;
}

button::after {
  border: 0;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.status-pending {
  color: #9a6700;
  background: #fff8c5;
}

.status-accepted {
  color: #1d4ed8;
  background: #dbeafe;
}

.status-repairing {
  color: #7e22ce;
  background: #f3e8ff;
}

.status-completed {
  color: #067647;
  background: #dcfae6;
}

.status-cancelled {
  color: #64748b;
  background: #eef2f6;
}

.empty-state {
  padding: 100rpx 36rpx;
  text-align: center;
}

.empty-icon {
  display: block;
  margin-bottom: 24rpx;
  font-size: 84rpx;
}

.empty-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
}
