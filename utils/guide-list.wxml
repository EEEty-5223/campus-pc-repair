<view class="portal-page guide-page">
  <view class="guide-hero"><text class="guide-eyebrow">CAMPUS COMPUTER GUIDE</text><view class="portal-title">{{favorites ? '我的收藏' : '让电脑，更好用'}}</view><view class="portal-subtitle">{{favorites ? '把有用的文章留在手边，下次遇到问题随时翻看。' : '电脑使用技巧与常用应用建议，和你一起少走弯路。'}}</view></view>
  <view class="guide-search"><input value="{{query}}" bindinput="input" bindconfirm="search" confirm-type="search" maxlength="80" placeholder="搜索文章标题或关键词"/><button bindtap="search">搜索</button></view>
  <view class="portal-tags"><view class="portal-tag {{category === item.id ? 'selected' : ''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="select">{{item.name}}</view></view>
  <view wx:if="{{error}}" class="portal-card portal-state portal-error">{{error}}<button class="portal-secondary" bindtap="load">重新加载</button></view>
  <view wx:elif="{{loading && !items.length}}" class="portal-state">正在整理文章…</view>
  <view wx:elif="{{!items.length}}" class="portal-card portal-state"><view class="guide-empty-icon">▥</view><view>{{query ? '没有找到相关内容，换个关键词试试' : (favorites ? '还没有收藏，读到喜欢的文章可以点收藏' : '文章正在准备中，发布后会出现在这里')}}</view></view>
  <view wx:for="{{items}}" wx:key="id" class="portal-card guide-article" data-id="{{item.id}}" bindtap="open"><image wx:if="{{item.coverUrl}}" class="portal-cover" src="{{item.coverUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="coverError" lazy-load/><view wx:if="{{item.coverFailed}}" class="portal-tip" data-id="{{item.id}}" catchtap="retryCover">图片加载失败，点击重试</view><view class="guide-article-category">{{item.categoryText}}</view><view class="guide-article-title">{{item.title}}</view><view wx:if="{{item.summary}}" class="guide-article-summary">{{item.summary}}</view><view class="portal-meta">{{item.dateText}} · {{item.authorName || '电脑e家'}}<text class="guide-read">阅读全文 ›</text></view></view>
  <button wx:if="{{hasMore && !error}}" class="portal-secondary" bindtap="more" loading="{{loading}}" disabled="{{loading}}">加载更多</button><view wx:if="{{items.length && !hasMore && !loading}}" class="guide-end">已经看到全部文章</view>
</view>
