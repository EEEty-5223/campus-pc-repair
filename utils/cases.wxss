@import "./portal.wxss";
.case-tabs{display:flex;background:#e5f2ef;border-radius:20rpx;padding:8rpx;margin-bottom:28rpx;gap:8rpx}.case-tab{flex:1;text-align:center;font-size:28rpx;padding:18rpx 10rpx;border-radius:16rpx;color:#6c8581}.case-tab.active{background:#fff;color:#087f7b;font-weight:700;box-shadow:0 4rpx 12rpx #15776a0a}.case-kicker{font-size:22rpx;letter-spacing:4rpx;color:#5f9e94;margin-bottom:10rpx}.case-search{display:flex;gap:12rpx;margin-top:26rpx}.case-search input{flex:1;min-width:0;background:white;border:1rpx solid #e1eae6;border-radius:16rpx;padding:0 22rpx;height:80rpx;font-size:27rpx}.case-search button{margin:0;font-size:26rpx;background:#e1f2ed;color:#087f7b;line-height:80rpx;padding:0 26rpx}.case-search button::after{border:0}.case-filters{display:flex;gap:16rpx;margin:20rpx 0 28rpx}.case-filters picker{flex:1;background:white;border-radius:16rpx;padding:20rpx;min-width:0;font-size:25rpx;color:#637c75}.case-card{display:flex;gap:22rpx;padding:28rpx;margin-top:20rpx;align-items:center}.case-info{flex:1;min-width:0}.case-person{font-size:32rpx;font-weight:750;line-height:1.5;word-break:break-all}.case-department{font-size:23rpx;font-weight:400;color:#7b958c;margin-left:14rpx}.case-kind{display:inline-block;font-size:22rpx;line-height:1.6;color:#268b7c;background:#edf8f3;padding:4rpx 14rpx;border-radius:10rpx;margin:12rpx 0}.case-location{font-size:26rpx;color:#4e6760;margin-top:8rpx;line-height:1.7;word-break:break-all}.case-time{font-size:23rpx;color:#899a94;margin-top:8rpx;line-height:1.7}.case-cover{width:156rpx;height:184rpx;border-radius:18rpx;flex-shrink:0;background:#e9f3ef}.case-image-retry{width:156rpx;flex-shrink:0;color:#138a7b;font-size:23rpx;text-align:center;line-height:1.7}.case-open{font-size:23rpx;color:#128b7c;margin-top:14rpx}.case-end{text-align:center;font-size:23rpx;color:#9aaba4;margin:35rpx 0}.case-detail-title{font-size:28rpx;font-weight:600;margin:18rpx 0 12rpx;color:#4f7368}.case-content{font-size:29rpx;white-space:pre-wrap;word-break:break-word;line-height:1.95;color:#3e564d}.case-photo{width:100%;height:380rpx;border-radius:20rpx;margin-top:20rpx;background:#eff6f2}.case-caption{font-size:23rpx;color:#8c9e95;line-height:1.8;margin-top:16rpx}.case-result{background:#edf9f1;border-left:5rpx solid #83b89a;border-radius:18rpx;padding:24rpx;font-size:28rpx;line-height:1.8;white-space:pre-wrap;word-break:break-word}.case-actions{display:flex;gap:16rpx}.case-actions button{flex:1;min-width:0}.case-status{display:inline-block;font-size:22rpx;padding:5rpx 14rpx;border-radius:12rpx;background:#edf5f0;color:#6c8c7e;margin-top:12rpx}.case-grid{display:flex;gap:16rpx;flex-wrap:wrap;margin-top:18rpx}.case-image-cell{width:calc((100% - 32rpx)/3);position:relative}.case-image-cell image{width:100%;height:170rpx;background:#edf4ef;border-radius:14rpx}.case-image-cell button{width:100%;padding:0;margin:6rpx 0 0;font-size:22rpx;color:#a56454;background:#faf1ed;line-height:54rpx}.case-image-cell button::after{border:0}.case-image-cell .import-image{background:#e4f5ed;color:#197f65}.case-small-textarea{height:190rpx}.case-confirm{display:flex;align-items:flex-start;margin-top:28rpx;font-size:25rpx;line-height:1.8;color:#637b70}.case-confirm checkbox{transform:scale(.8);margin-left:-10rpx}.case-preview-label{font-size:22rpx;color:#6c9e8a;letter-spacing:3rpx;margin-bottom:20rpx}.case-source-id{font-size:22rpx;color:#9aaba3;word-break:break-all;margin-top:14rpx}
