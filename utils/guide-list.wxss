@import "./portal.wxss";
.guide-hero{background:linear-gradient(135deg,#e1f7f4,#eef8f4);border-radius:28rpx;padding:34rpx 28rpx}.guide-eyebrow{color:#44a6a0;font-size:20rpx;letter-spacing:3rpx;display:block;margin-bottom:14rpx}.guide-hero .portal-title{font-size:43rpx}.guide-search{display:flex;gap:18rpx;background:#fff;border:1rpx solid #e4edf3;border-radius:20rpx;margin-top:26rpx;padding:12rpx 14rpx 12rpx 24rpx;align-items:center}.guide-search input{flex:1;font-size:26rpx;min-width:0}.guide-search button{font-size:24rpx;line-height:58rpx;padding:0 24rpx;color:var(--color-primary-strong, #087f7b);background:#e9f7f6;margin:0}.guide-search button::after{border:0}.guide-article{padding:24rpx}.guide-article-category{display:inline-block;font-size:22rpx;color:var(--color-primary-strong, #087f7b);background:#ebf9f7;padding:7rpx 15rpx;border-radius:10rpx;margin-top:16rpx}.guide-article-title{font-size:33rpx;font-weight:700;line-height:1.6;margin:14rpx 0 10rpx}.guide-article-summary{font-size:26rpx;color:#7a8b9c;line-height:1.9;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.guide-read{float:right;color:var(--color-primary-strong, #087f7b)}.guide-empty-icon{font-size:72rpx;color:#67bcb5;padding:20rpx}.guide-end{text-align:center;font-size:23rpx;color:#9eaab5;padding:32rpx}
