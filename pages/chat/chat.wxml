<view id="chat-viewport-probe" class="chat-viewport-probe" aria-hidden="true"></view>
<view
  class="chat-page {{keyboardHeight > 0 ? 'keyboard-open' : ''}}"
  style="bottom: {{keyboardInset}}px;"
  wx:if="{{item}}"
>
  <view wx:if="{{!keyboardHeight}}" class="chat-leave-note"><view>离开后收不到新消息推送，请回首页“快速沟通”查看未读。</view><button class="chat-leave-button" bindtap="leaveChat">离开聊天</button></view>
  <view wx:if="{{loadError}}" class="chat-load-error">{{loadError}}<text bindtap="loadItem"> 点击重试</text></view>
  <view wx:if="{{!keyboardHeight}}" class="chat-summary card">
    <view class="chat-summary-row">
      <text class="chat-summary-label">预约编号</text>
      <text class="chat-summary-value">{{item.id}}</text>
    </view>
    <view class="chat-summary-row no-border">
      <text class="chat-summary-label">当前状态</text>
      <text class="chat-summary-value status-pill {{item.statusClass}}">{{item.statusText}}</text>
    </view>
  </view>

  <view class="chat-card card">
    <view class="chat-list-wrap">
      <scroll-view
        class="chat-list"
        scroll-y="true"
        scroll-into-view="{{scrollIntoView}}"
        scroll-with-animation="true"
      >
        <view wx:if="{{!item.hasMessages}}" class="chat-empty">暂无消息，开始下面的对话吧。</view>

        <view
          class="chat-msg {{msg.viewerClass}}"
          wx:for="{{item.messages}}"
          wx:for-item="msg"
          wx:key="id"
          id="msg-{{msg.id}}"
        >
          <view class="chat-bubble">
            <view class="chat-meta">{{msg.fromText}} · {{msg.atText}}</view>
            <view wx:if="{{msg.isAssignmentNotice}}" class="assignment-notice"><view class="assignment-notice-title">{{msg.content}}</view><view wx:for="{{msg.assignmentPeople}}" wx:for-item="person" wx:key="openid" class="notice-person"><view>{{person.isPrimary || person.position === 'primary' ? '主要负责人' : '随行人员'}}：{{person.nickname || person.name || '社团成员'}} · {{person.department || '未填写部门'}}</view><view class="notice-phone"><text>{{person.phone || '暂未填写手机号'}}</text><button wx:if="{{person.phone}}" class="notice-copy" bindtap="copyPhone" data-phone="{{person.phone}}">复制</button></view></view><view wx:if="{{!msg.assignmentPeople.length}}">本次分配暂无服务人员</view><view class="notice-hint">此为分配时的信息，最新安排请查看预约详情。</view></view>
            <view wx:elif="{{msg.type === 'image'}}" class="chat-image-wrap">
              <view wx:if="{{msg.isAdminNotice}}" class="chat-text">社团负责人：</view><image class="chat-image" src="{{msg.imageUrl}}" mode="widthFix" bindtap="previewImage" data-url="{{msg.imageUrl}}" lazy-load="true"></image>
            </view>
            <view wx:else class="chat-text">{{msg.isAdminNotice ? '社团负责人：' : ''}}{{msg.content}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="chat-input-bar" wx:if="{{item.canReply}}">
      <view class="chat-image-btn" bindtap="chooseImage">+</view>
      <textarea
        class="chat-input"
        style="height: {{chatInputHeight}}rpx;"
        placeholder="{{role === 'admin' ? '回复用户…' : '与社团沟通'}}"
        value="{{chatText}}"
        maxlength="200"
        fixed="{{true}}"
        adjust-position="{{false}}"
        bindkeyboardheightchange="onChatKeyboardHeightChange"
        bindlinechange="onChatInputLineChange"
        show-confirm-bar="{{false}}"
        bindinput="onChatInput"
        bindconfirm="sendMessage"
      />
      <button class="chat-send" bindtap="sendMessage" disabled="{{sending}}">发送</button>
    </view>
    <view class="chat-closed" wx:else>{{item.isVoided ? '预约已作废，仅可查看历史消息' : '预约已结束，当前仅可查看历史消息'}}</view>
  </view>
</view>

<view class="page" wx:else>
  <view class="chat-leave-note"><view>离开后收不到新消息推送，请回首页查看未读。</view><button class="chat-leave-button" bindtap="leaveChat">离开聊天</button></view>
  <view class="card empty-state">
    <text class="empty-icon">🔎</text>
    <text class="empty-title">{{loading ? '正在加载聊天…' : (loadError || '未找到预约')}}</text><button wx:if="{{!loading}}" class="chat-leave-button" bindtap="loadItem">重新加载</button>
  </view>
</view>
