page {
  height: 100%;
  overflow: hidden;
}

.chat-viewport-probe {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  visibility: hidden;
  pointer-events: none;
}

.chat-page {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}
.chat-leave-note { margin-bottom:20rpx;padding:20rpx;color:#475569;font-size:23rpx;line-height:1.65;background:var(--color-primary-soft, #edf8f4);border:1rpx solid var(--color-primary-tint, #dcf4eb);border-radius:16rpx; }
.chat-leave-button { margin:14rpx 0 0;padding:0 20rpx;font-size:23rpx;line-height:58rpx;color:var(--color-primary, #0b8f89);background:#ffffff;border-radius:10rpx; }
.chat-load-error { margin-bottom:16rpx;color:#b42318;font-size:23rpx;line-height:1.6; }

.chat-summary {
  flex-shrink: 0;
  padding: 24rpx 30rpx;
}

.chat-summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #e8f0eb;
}

.chat-summary-row.no-border {
  border-bottom: none;
}

.chat-summary-label {
  color: #64748b;
  font-size: 26rpx;
}

.chat-summary-value {
  color: #1f2937;
  font-size: 26rpx;
}

.chat-card {
  padding: 12rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  margin-bottom: 0;
}

.chat-list-wrap {
  flex: 1;
  min-height: 0;
  height: 0;
  overflow: hidden;
}

.chat-list {
  height: 100%;
}

.chat-empty {
  padding: 60rpx 10rpx;
  color: #94a3b8;
  font-size: 26rpx;
  text-align: center;
}

.chat-msg {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.chat-msg.msg-own {
  flex-direction: row-reverse;
}

.chat-msg.msg-other {
  justify-content: flex-start;
}

.chat-bubble {
  max-width: calc(100% - 132rpx);
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  word-break: break-all;
}

.msg-own .chat-bubble {
  background: var(--color-primary, #0b8f89);
  border-top-right-radius: 4rpx;
}

.msg-other .chat-bubble {
  background: #ffffff;
  border: 1rpx solid var(--color-primary-tint, #dcf4eb);
  border-top-left-radius: 4rpx;
}

.chat-meta {
  margin-bottom: 8rpx;
  font-size: 20rpx;
  opacity: 0.7;
}

.msg-own .chat-meta,
.msg-own .chat-text {
  color: #ffffff;
}

.msg-other .chat-meta {
  color: var(--color-primary-strong, #087f7b);
}

.msg-other .chat-text {
  color: #334155;
}

.chat-text {
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.chat-image-wrap {
  margin-top: 8rpx;
}

.chat-image {
  display: block;
  width: 260rpx;
  height: 320rpx;
  max-width: 100%;
  max-height: 360rpx;
  border-radius: 12rpx;
}

.chat-input-bar {
  display: flex;
  align-items: flex-end;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #e8f0eb;
}

.chat-image-btn {
  width: 72rpx;
  height: 72rpx;
  margin: 0 12rpx 4rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary, #0b8f89);
  font-size: 40rpx;
  font-weight: bold;
  background: #f1f5f9;
  border-radius: 28rpx;
  flex-shrink: 0;
}

.chat-input {
  flex: 1;
  box-sizing: border-box;
  width: 0;
  min-width: 0;
  height: 72rpx;
  min-height: 72rpx;
  max-height: 150rpx;
  padding: 14rpx 20rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 32rpx;
  overflow-y: auto;
}

.chat-send {
  width: auto !important;
  min-width: 0 !important;
  height: 72rpx;
  margin: 0 0 4rpx 16rpx;
  padding: 0 18rpx;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 72rpx;
  background: var(--color-primary, #0b8f89);
  border-radius: 28rpx;
  flex-shrink: 0;
}

.chat-send[disabled] {
  opacity: 0.6;
}

.chat-closed {
  margin-top: 20rpx;
  padding: 16rpx;
  color: #94a3b8;
  font-size: 24rpx;
  text-align: center;
}

.chat-msg.msg-assignment,.chat-msg.msg-admin-notice{justify-content:center}.msg-assignment .chat-bubble,.msg-admin-notice .chat-bubble{max-width:90%;background:#f1f5f9;border:1rpx solid #e2e8f0;border-radius:14rpx;color:#475569}.msg-admin-notice .chat-text{font-size:24rpx;color:#475569}.msg-admin-notice .chat-meta,.msg-assignment .chat-meta{color:#64748b}.assignment-notice{font-size:25rpx;line-height:1.7}.assignment-notice-title{font-weight:600}.notice-person{padding:14rpx 0;border-bottom:1rpx solid #e2e8f0}.notice-phone{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.notice-copy{width:auto!important;min-width:0!important;padding:0 20rpx;margin:0;line-height:48rpx;font-size:23rpx;color:var(--color-primary, #0b8f89);background:white}.notice-hint{margin-top:14rpx;font-size:21rpx;color:#64748b}

.chat-input-bar,
.chat-closed {
  flex-shrink: 0;
}
.chat-page.keyboard-open {
  padding-top: 8rpx;
  padding-bottom: 0;
}

.chat-subscribe-link{color:var(--color-primary-strong, #087f7b);margin-left:10rpx;font-weight:600}

.chat-avatar { width:72rpx;height:72rpx;flex-shrink:0;border-radius:10rpx;background:#e6f2ef;border:1rpx solid #dbe8e4; }
.chat-image-failed { width:240rpx;max-width:100%;min-height:140rpx;display:flex;align-items:center;justify-content:center;font-size:24rpx;line-height:1.6;background:#e9eef1;color:#52606d;border-radius:10rpx; }
.chat-msg.msg-admin-notice { justify-content:flex-start; }
.msg-admin-notice .chat-bubble { max-width:calc(100% - 132rpx); }
.chat-msg.msg-assignment { flex-direction:row; }
