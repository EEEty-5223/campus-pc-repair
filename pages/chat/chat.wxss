.chat-page {
  height: 100vh;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.chat-leave-note { margin-bottom:20rpx;padding:20rpx;color:#475569;font-size:23rpx;line-height:1.65;background:#eff6ff;border:1rpx solid #dbeafe;border-radius:16rpx; }
.chat-leave-button { margin:14rpx 0 0;padding:0 20rpx;font-size:23rpx;line-height:58rpx;color:#2563eb;background:#ffffff;border-radius:10rpx; }
.chat-load-error { margin-bottom:16rpx;color:#b42318;font-size:23rpx;line-height:1.6; }

.chat-summary {
  padding: 24rpx 30rpx;
}

.chat-summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #edf1f7;
}

.chat-summary-row.no-border {
  border-bottom: none;
}

.chat-summary-label {
  color: #64748b;
  font-size: 26rpx;
}

.chat-summary-value {
  color: #1f2937;
  font-size: 26rpx;
}

.chat-card {
  padding: 12rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  margin-bottom: 0;
}

.chat-list-wrap {
  flex: 1;
  min-height: 0;
  height: 0;
  overflow: hidden;
}

.chat-list {
  height: 100%;
}

.chat-empty {
  padding: 60rpx 10rpx;
  color: #94a3b8;
  font-size: 26rpx;
  text-align: center;
}

.chat-msg {
  display: flex;
  margin-bottom: 24rpx;
}

.chat-msg.msg-own {
  justify-content: flex-end;
}

.chat-msg.msg-other {
  justify-content: flex-start;
}

.chat-bubble {
  max-width: 78%;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  word-break: break-all;
}

.msg-own .chat-bubble {
  background: #2563eb;
  border-top-right-radius: 4rpx;
}

.msg-other .chat-bubble {
  background: #ffffff;
  border: 1rpx solid #dbeafe;
  border-top-left-radius: 4rpx;
}

.chat-meta {
  margin-bottom: 8rpx;
  font-size: 20rpx;
  opacity: 0.7;
}

.msg-own .chat-meta,
.msg-own .chat-text {
  color: #ffffff;
}

.msg-other .chat-meta {
  color: #1d4ed8;
}

.msg-other .chat-text {
  color: #334155;
}

.chat-text {
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.chat-image-wrap {
  margin-top: 8rpx;
}

.chat-image {
  max-width: 100%;
  max-height: 360rpx;
  border-radius: 12rpx;
}

.chat-input-bar {
  display: flex;
  align-items: flex-end;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf1f7;
}

.chat-image-btn {
  width: 72rpx;
  height: 72rpx;
  margin: 0 12rpx 4rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2563eb;
  font-size: 40rpx;
  font-weight: bold;
  background: #f1f5f9;
  border-radius: 28rpx;
  flex-shrink: 0;
}

.chat-input {
  flex: 1;
  min-height: 80rpx;
  max-height: 240rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 32rpx;
  overflow-y: auto;
}

.chat-send {
  width: auto !important;
  min-width: 0 !important;
  height: 72rpx;
  margin: 0 0 4rpx 16rpx;
  padding: 0 18rpx;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 72rpx;
  background: #2563eb;
  border-radius: 28rpx;
  flex-shrink: 0;
}

.chat-send[disabled] {
  opacity: 0.6;
}

.chat-closed {
  margin-top: 20rpx;
  padding: 16rpx;
  color: #94a3b8;
  font-size: 24rpx;
  text-align: center;
}

.chat-msg.msg-assignment,.chat-msg.msg-admin-notice{justify-content:center}.msg-assignment .chat-bubble,.msg-admin-notice .chat-bubble{max-width:90%;background:#f1f5f9;border:1rpx solid #e2e8f0;border-radius:14rpx;color:#475569}.msg-admin-notice .chat-text{font-size:24rpx;color:#475569}.msg-admin-notice .chat-meta,.msg-assignment .chat-meta{color:#64748b}.assignment-notice{font-size:25rpx;line-height:1.7}.assignment-notice-title{font-weight:600}.notice-person{padding:14rpx 0;border-bottom:1rpx solid #e2e8f0}.notice-phone{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.notice-copy{width:auto!important;min-width:0!important;padding:0 20rpx;margin:0;line-height:48rpx;font-size:23rpx;color:#2563eb;background:white}.notice-hint{margin-top:14rpx;font-size:21rpx;color:#64748b}
