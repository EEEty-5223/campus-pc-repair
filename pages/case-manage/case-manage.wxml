<view class="portal-page"><view class="portal-title">案例工作台</view><view class="portal-subtitle">从已完成预约中整理服务记录，确认公开内容后再发布。</view>
  <view class="case-tabs" style="margin-top:24rpx"><view class="case-tab {{!sources ? 'active' : ''}}" data-type="cases" bindtap="toggle">已整理案例</view><view class="case-tab {{sources ? 'active' : ''}}" data-type="sources" bindtap="toggle">选择已完成预约</view></view>
  <view wx:if="{{sources}}" class="case-search"><input value="{{query}}" maxlength="80" bindinput="input" bindconfirm="load" placeholder="按预约编号或故障类型查找"/><button bindtap="load">查找</button></view>
  <view wx:if="{{error}}" class="portal-card portal-state portal-error">{{error}}<button class="portal-secondary" bindtap="load">重新加载</button></view><view wx:elif="{{loading && !items.length}}" class="portal-state">正在加载…</view><view wx:elif="{{!items.length}}" class="portal-card portal-state">{{sources ? '暂无可整理的已完成预约。作废或待审核的预约不会出现在这里。' : '还没有整理案例，先选择一笔已完成预约。'}}</view>
  <view class="portal-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="case-person">{{item.technicianNames}}<text class="case-department">{{item.department}}</text></view><view class="case-kind">{{item.faultType}}</view><view wx:if="{{!sources}}" class="case-location">{{item.title}}</view><view class="case-time">预约 {{item.appointmentDateText}} · 完成 {{item.completedDateText}}</view><view wx:if="{{!sources}}" class="case-status">{{item.status === 'published' ? '已发布' : '草稿'}}</view><view wx:if="{{sources}}" class="case-source-id">{{item.id}}</view><view class="case-open">{{sources ? (busy ? '正在准备…' : '整理为案例 ›') : '查看和编辑 ›'}}</view></view>
  <button wx:if="{{hasMore}}" class="portal-secondary" bindtap="more" loading="{{loading}}" disabled="{{loading || busy}}">加载更多</button>
</view>
