<view class="page detail-page" wx:if="{{item}}">
  <view class="status-card card">
    <view class="status-pill {{item.statusClass}}">{{item.statusText}}</view>
    <view class="status-title">预约编号 {{item.id}}</view>
    <view class="status-desc">提交于 {{item.createdAtText}}</view>
  </view>
  <view wx:if="{{item.adminIntervened}}" class="card intervention-banner">此预约有管理员介入，处理原因和时间见下方维修日志。</view>
  <view class="tip-card">提示：维修前请自行备份重要文件，不要在故障描述中填写账号或密码。</view>
  <view wx:if="{{role === 'user' && !item.isVoided && (item.status === 'pending' || item.status === 'accepted')}}" class="card completion-code-card">
    <view class="detail-section-title">维修开工码</view>
    <view wx:if="{{startCode}}" class="completion-code">{{startCode}}</view>
    <view wx:elif="{{startCodeLoading}}" class="completion-note">正在加载开工码…</view>
    <view wx:else class="completion-error">{{startCodeError || '开工码暂不可用'}}<button class="secondary-button" bindtap="loadStartCode">刷新开工码</button></view>
    <view class="completion-note">请先确认维修方案、费用和重要数据备份，维修人员到场且你同意开始维修后，再提供开工码。重装系统、格式化等操作还需单独取得你的明确同意。</view>
    <view class="service-terms-link" bindtap="goServiceTerms">查看《维修服务说明与风险告知》 ›</view>
  </view>
  <view wx:if="{{role === 'user' && !item.isVoided && item.status === 'repairing'}}" class="card completion-code-card">
    <view class="detail-section-title">维修完成确认码</view>
    <view wx:if="{{completionCode}}" class="completion-code">{{completionCode}}</view>
    <view wx:elif="{{codeLoading}}" class="completion-note">正在加载确认码…</view>
    <view wx:else class="completion-error">{{codeError || '确认码暂不可用'}}<button class="secondary-button" bindtap="loadCompletionCode">刷新确认码</button></view>
    <view class="completion-note">请在维修完成并确认结果后，再将此码告知服务人员。完成预约后此码失效；提供完成码不代表放弃依法提出异议或追究责任的权利。</view>
  </view>

  <view wx:if="{{item.isVoided}}" class="void-note card"><view>预约已作废，当前仅可查看历史。</view><view>原因：{{item.voidReason}}</view></view>
  <view wx:if="{{!item.isVoided && item.status !== 'completed' && item.status !== 'cancelled'}}" class="card subscription-detail-entry" bindtap="subscribeMessages"><view>♧ {{role === 'admin' ? '后台总消息订阅' : '订阅一次本单消息'}} ›</view><view class="completion-note">仅订阅一次消息，用完需再次订阅。{{role === 'admin' ? '接收你权限范围内的消息。' : '只用于此预约的状态变化或新聊天消息。'}}</view></view>
  <view wx:if="{{evidence}}" class="card completion-evidence"><view class="detail-section-title">完工记录</view><view class="completion-note">{{evidence.evidenceType === 'photos' ? '已上传完工照片' : (evidence.evidenceType === 'admin_force' ? '管理员特殊完工' : '用户不方便拍照')}}{{evidence.reviewStatus ? (' · ' + (evidence.reviewStatus === 'pending' ? '待审核' : (evidence.reviewStatus === 'approved' ? '已通过审核' : '审核未通过'))) : ''}}</view><view wx:if="{{evidence.note}}" class="completion-note">补充说明：{{evidence.note}}</view><view wx:if="{{evidence.reviewReason}}" class="completion-note">审核说明：{{evidence.reviewReason}}</view><view class="evidence-photos"><block wx:for="{{evidence.photos}}" wx:key="id"><image wx:if="{{item.url}}" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="previewEvidence" binderror="evidenceImageFailed"/><view wx:else class="completion-note" bindtap="loadEvidence">照片加载失败，点击重试</view></block></view><button wx:if="{{evidence.canResubmit}}" class="secondary-button" bindtap="resubmitEvidence">补充说明并重提审核</button></view>
  <view wx:if="{{evidenceError}}" class="completion-error" bindtap="loadEvidence">{{evidenceError}}，点击重试</view>
  <view class="detail-actions">
    <button class="primary-button chat-cta" wx:if="{{role !== 'admin' && item.canChat !== false}}" bindtap="goChat">{{!item.canReply ? '查看历史沟通' : '点击与社团沟通'}}</button>
    <button class="secondary-button" wx:if="{{role === 'admin' && item.canChat !== false}}" bindtap="goChat">{{!item.canReply ? '查看历史沟通' : '进入沟通'}}</button>
    <button class="secondary-button" wx:if="{{item.canEdit}}" bindtap="editBooking">修改预约</button>
    <button class="danger-button" wx:if="{{item.canCancel}}" bindtap="cancelBooking">取消预约</button>
  </view>

  <view wx:if="{{isRealAdmin && item.isVoided}}" class="card admin-special-actions"><view class="detail-section-title">管理员特殊操作</view><view class="completion-note">恢复后保留作废前的状态。未开工预约会更新开工码，进行中的预约会更新完成码；已完成或已取消的预约仍只读。</view><button class="secondary-button" disabled="{{adminActionBusy}}" bindtap="restoreAppointment">恢复预约</button></view>
  <view wx:if="{{isRealAdmin && !item.isVoided}}" class="card admin-special-actions"><view class="detail-section-title">管理员特殊操作</view><view class="completion-note">特殊操作需要原因并记录日志。正常开工及完成维修分别需要用户的开工码和完成码。</view><button class="secondary-button" disabled="{{adminActionBusy}}" bindtap="forceStatus">强制修改状态</button><button wx:if="{{item.status !== 'completed'}}" class="secondary-button" disabled="{{adminActionBusy}}" bindtap="forceComplete">强制完成（跳过确认码）</button><button class="danger-button" disabled="{{adminActionBusy}}" bindtap="voidAppointment">作废并隐藏</button></view>
  <view class="card repair-history">
    <view class="detail-section-title">维修日志</view>
    <view wx:for="{{item.repairHistory}}" wx:key="id" class="history-entry {{item.isIntervention ? 'history-intervention' : ''}}">
      <view class="history-title">{{item.title}}</view><view class="history-meta">{{item.atText}} · {{item.actorName}}</view>
      <view wx:if="{{item.reason}}" class="history-reason">原因：{{item.reason}}</view>
    </view>
    <view wx:if="{{!item.repairHistory.length}}" class="completion-note">暂无历史日志；缺失的旧时间不会补造。</view>
  </view>
  <view class="card detail-card service-team"><view class="detail-section-title">服务人员</view><view wx:if="{{!item.assignees.length}}" class="completion-note">尚未分配服务人员</view><view wx:for="{{item.assignees}}" wx:for-item="person" wx:key="openid" class="service-person"><view class="service-person-head"><text class="service-position">{{person.isPrimary || person.position === 'primary' ? '主要负责人' : '随行人员'}}</text><text class="service-person-name">{{person.nickname || person.name || '社团成员'}}</text></view><view class="service-department">{{person.department || '未填写部门'}}</view><view class="service-phone-row"><text>{{person.phone || '暂未填写手机号'}}</text><button wx:if="{{person.phone}}" class="phone-copy" data-phone="{{person.phone}}" bindtap="copyPhone">复制</button></view></view></view>
  <view class="card detail-card">
    <view class="detail-section-title">预约安排</view>
    <view class="detail-row">
      <text class="detail-label">预约日期</text>
      <text class="detail-value">{{item.appointmentDate}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-label">时间段</text>
      <text class="detail-value">{{item.timeSlot}}</text>
    </view>
    <view class="detail-row no-border">
      <text class="detail-label">联系地点</text>
      <text class="detail-value">{{item.location}}</text>
    </view>
  </view>

  <view class="card detail-card">
    <view class="detail-section-title">设备信息</view>
    <view class="detail-row">
      <text class="detail-label">设备类型</text>
      <text class="detail-value">{{item.deviceType}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-label">故障类别</text>
      <text class="detail-value">{{item.faultType}}</text>
    </view>
    <view class="description-block">
      <view class="detail-label">故障描述</view>
      <view class="description-text">{{item.description}}</view>
    </view>
  </view>

  <view class="card detail-card">
    <view class="detail-section-title">联系方式</view>
    <view class="detail-row">
      <text class="detail-label">联系人</text>
      <text class="detail-value">{{item.name}}</text>
    </view>
    <view class="detail-row no-border">
      <text class="detail-label">手机号</text>
      <text class="detail-value">{{item.phone}}</text>
    </view>
  </view>

</view>

<view class="page" wx:else>
  <view class="card empty-state">
    <text class="empty-icon">🔎</text>
    <text class="empty-title">{{loading ? '正在加载预约…' : (loadError || '未找到预约')}}</text>
    <button wx:if="{{!loading}}" class="secondary-button" bindtap="loadItem">刷新预约</button>
  </view>
</view>
