<view class="page consult-page">
  <view class="consult-head">
    <view>
      <view class="consult-title">快速沟通</view>
      <view class="consult-subtitle">选择进行中的预约，一键联系社团成员</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="card empty-state">
    <text class="empty-title">加载中…</text>
  </view>

  <view wx:elif="{{items.length}}">
    <view class="card consult-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}">
      <view class="consult-row">
        <view class="consult-info">
          <view class="consult-top">
            <text class="consult-device">{{item.deviceType}}</text>
          </view>
          <view class="consult-fault">{{item.faultType}} · {{item.description}}</view>
          <view class="consult-meta">{{item.appointmentDate}} {{item.timeSlot}} · {{item.location}}</view>
        </view>
        <view class="consult-action">
          <text class="status-pill {{item.statusClass}}">{{item.statusText}}</text>
          <button class="consult-button" data-id="{{item.id}}" bindtap="goChat">点击咨询</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="card empty-state">
    <text class="empty-icon">💬</text>
    <text class="empty-title">暂无可沟通的预约</text>
    <text class="muted">已结束或已取消的预约不会显示在这里</text>
    <button class="primary-button empty-button" bindtap="goBooking">预约电脑维修</button>
  </view>
</view>