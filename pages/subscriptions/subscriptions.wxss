@import "../../utils/portal.wxss";
.subscription-availability-note { margin-top: 16rpx; padding: 20rpx; border-radius: 16rpx; color: #50766c; background: var(--color-primary-soft, #edf8f4); font-size: 24rpx; line-height: 1.8; }
.subscribe-art{width:110rpx;height:110rpx;line-height:110rpx;text-align:center;background:#e8f8f4;color:var(--color-primary, #0b8f89);border-radius:32rpx;margin:14rpx auto 28rpx;font-size:66rpx}.subscription-heading{text-align:center;font-size:32rpx;font-weight:700}.once-emphasis{display:block;font-size:29rpx;font-weight:700;margin-bottom:12rpx}.subscription-status{font-size:27rpx;margin-top:28rpx}.subscription-actions{display:flex;justify-content:space-between;font-size:25rpx;color:#559f9b;margin:30rpx 0}.subscription-scope{font-size:23rpx;color:#7c8c9b;word-break:break-all;margin-top:20rpx}
