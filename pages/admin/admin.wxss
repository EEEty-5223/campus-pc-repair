/* 新预约提醒：沿用后台蓝色，状态和授权说明独立于预约处理。 */
.backend-tools { display:flex;flex-wrap:wrap;gap:14rpx;margin:0 0 24rpx; }
.backend-tool { display:flex;align-items:center;flex-wrap:wrap;gap:12rpx;margin:0;padding:18rpx 22rpx;max-width:100%;box-sizing:border-box;line-height:1.6;background:white;border:1rpx solid #e2e8f0;border-radius:16rpx;font-size:26rpx;color:#334155; }
.tool-meta { font-size:22rpx;color:#94a3b8; }
.tool-active { color:var(--color-primary, #0b8f89); }
.tool-arrow { color:#94a3b8; }
.special-count { display:flex;align-items:center;gap:6rpx;color:#dc2626;font-size:23rpx; }
.special-dot { width:12rpx;height:12rpx;border-radius:50%;background:#ef4444;flex-shrink:0; }
.special-order-notice { display:flex;align-items:center;gap:10rpx;margin:16rpx 0 0;padding:14rpx 18rpx;background:#fff1f0;color:#b42318;border-radius:12rpx;font-size:24rpx;line-height:1.6; }
.notification-card { padding: 28rpx; border: 1rpx solid var(--color-primary-tint, #dcf4eb); }
.notification-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.notification-title { font-size: 29rpx; font-weight: 700; color: #1e293b; }
.notification-status { padding: 7rpx 16rpx; font-size: 21rpx; color: #475569; background: #f1f5f9; border-radius: 999rpx; }
.notification-status-active { color: var(--color-primary-strong, #087f7b); background: var(--color-primary-soft, #edf8f4); }
.notification-description { margin-top: 18rpx; font-size: 25rpx; line-height: 1.7; color: #334155; }
.notification-note { margin-top: 14rpx; padding: 16rpx; font-size: 23rpx; line-height: 1.6; color: var(--color-primary-strong, #087f7b); background: var(--color-primary-soft, #edf8f4); border-radius: 12rpx; }
.notification-meta, .notification-footnote { margin-top: 14rpx; font-size: 22rpx; line-height: 1.65; color: #64748b; }
.notification-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; margin-top: 22rpx; }
.notification-stop { margin: 0; padding: 0 8rpx; font-size: 23rpx; color: #64748b; background: transparent; line-height: 64rpx; }
.notification-stop::after { border: none; }
.notification-actions button[disabled] { color: #94a3b8; background: #f1f5f9; }
.list-state { padding: 32rpx; text-align: center; color: #64748b; font-size: 25rpx; }
.list-error button { margin: 20rpx auto 0; display: inline-block; }

/* ===== Tab 切换栏 ===== */
.tab-bar {
  display: flex;
  margin-bottom: 28rpx;
  padding: 8rpx;
  background: #ffffff;
  border-radius: 18rpx;
