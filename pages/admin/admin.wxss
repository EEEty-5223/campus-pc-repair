/* 新预约提醒：沿用后台蓝色，状态和授权说明独立于预约处理。 */
.notification-card { padding: 28rpx; border: 1rpx solid #dbeafe; }
.notification-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.notification-title { font-size: 29rpx; font-weight: 700; color: #1e293b; }
.notification-status { padding: 7rpx 16rpx; font-size: 21rpx; color: #475569; background: #f1f5f9; border-radius: 999rpx; }
.notification-status-active { color: #1d4ed8; background: #eff6ff; }
.notification-description { margin-top: 18rpx; font-size: 25rpx; line-height: 1.7; color: #334155; }
.notification-note { margin-top: 14rpx; padding: 16rpx; font-size: 23rpx; line-height: 1.6; color: #1d4ed8; background: #eff6ff; border-radius: 12rpx; }
.notification-meta, .notification-footnote { margin-top: 14rpx; font-size: 22rpx; line-height: 1.65; color: #64748b; }
.notification-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; margin-top: 22rpx; }
.notification-stop { margin: 0; padding: 0 8rpx; font-size: 23rpx; color: #64748b; background: transparent; line-height: 64rpx; }
.notification-stop::after { border: none; }
.notification-actions button[disabled] { color: #94a3b8; background: #f1f5f9; }
.list-state { padding: 32rpx; text-align: center; color: #64748b; font-size: 25rpx; }
.list-error button { margin: 20rpx auto 0; display: inline-block; }

/* ===== Tab 切换栏 ===== */
.tab-bar {
  display: flex;
  margin-bottom: 28rpx;
  padding: 8rpx;
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
}

.tab-item {
  position: relative;
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  color: #64748b;
  font-size: 26rpx;
  font-weight: 600;
}

.tab-active {
  color: #ffffff;
  background: #2563eb;
  border-radius: 12rpx;
}

.tab-badge {
  display: inline-block;
  margin-left: 8rpx;
  padding: 2rpx 12rpx;
  color: #ffffff;
  font-size: 20rpx;
  background: #ef4444;
  border-radius: 999rpx;
}

.reply-actions {
  display: flex;
  margin-top: 14rpx;
  gap: 12rpx;
}

/* ===== 邀请码管理 ===== */
.invite-action-card {
  text-align: center;
}

.invite-action-title {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.invite-action-desc {
  margin-bottom: 24rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.6;
}

.generate-button {
  height: 80rpx;
  margin: 0;
  padding: 0 40rpx;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 80rpx;
  background: #2563eb;
  border-radius: 14rpx;
}

.invite-card {
  padding: 24rpx;
}

.invite-code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.invite-code-text {
  font-size: 32rpx;
  font-weight: 800;
  color: #1e293b;
  letter-spacing: 2rpx;
}

.invite-status-pill {
  padding: 6rpx 18rpx;
  font-size: 21rpx;
  border-radius: 999rpx;
}

.invite-status-valid {
  color: #ffffff;
  background: #079455;
}

.invite-status-used {
  color: #475569;
  background: #f1f5f9;
}

.invite-status-expired {
  color: #b42318;
  background: #fef2f2;
}

.invite-meta {
  margin-bottom: 6rpx;
  color: #64748b;
  font-size: 22rpx;
}

.copy-btn {
  margin-top: 14rpx;
}

.primary-button {
  color: #ffffff;
  background: #2563eb;
}

/* ===== 申请审核 ===== */
.apply-card {
  padding: 24rpx;
}

.apply-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.apply-name {
  margin-bottom: 6rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.apply-dept {
  color: #64748b;
  font-size: 23rpx;
}

.apply-status-pill {
  padding: 6rpx 18rpx;
  font-size: 21rpx;
  border-radius: 999rpx;
}

.apply-status-pending {
  color: #b45309;
  background: #fef3c7;
}

.apply-status-approved {
  color: #ffffff;
  background: #079455;
}

.apply-status-rejected {
  color: #b42318;
  background: #fef2f2;
}

.apply-meta {
  margin-bottom: 6rpx;
  color: #64748b;
  font-size: 22rpx;
}

.apply-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
  gap: 12rpx;
}

.demo-warning {
  margin-bottom: 30rpx;
  padding: 24rpx;
  color: #7c2d12;
  font-size: 23rpx;
  line-height: 1.65;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  border-radius: 18rpx;
}

.warning-title {
  margin-bottom: 8rpx;
  font-weight: 700;
}

.admin-head,
.admin-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.admin-head {
  margin: 4rpx 4rpx 24rpx;
}

.admin-title {
  font-size: 38rpx;
  font-weight: 800;
}

.admin-count {
  color: #64748b;
  font-size: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-bottom: 26rpx;
  gap: 16rpx;
}

.stat-card {
  padding: 24rpx 12rpx;
  color: #1d4ed8;
  text-align: center;
  background: #eff6ff;
  border-radius: 18rpx;
}

.active-stat {
  color: #7e22ce;
  background: #faf5ff;
}

.completed-stat {
  color: #067647;
  background: #ecfdf3;
}

.stat-value {
  font-size: 38rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.filter-scroll {
  width: 100%;
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  padding: 2rpx 2rpx 8rpx;
  gap: 14rpx;
}

.filter-chip {
  display: inline-flex;
  padding: 14rpx 24rpx;
  color: #64748b;
  font-size: 23rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 999rpx;
}

.filter-chip-active {
  color: #ffffff;
  background: #2563eb;
  border-color: #2563eb;
}

.customer-name {
  margin-bottom: 8rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.customer-phone {
  color: #64748b;
  font-size: 23rpx;
}

.fault-summary {
  margin: 24rpx 0 14rpx;
  color: #334155;
  font-size: 25rpx;
  line-height: 1.6;
}

.schedule {
  padding: 18rpx;
  color: #475569;
  font-size: 23rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

.assign-info {
  margin: 16rpx 0 0;
  padding: 12rpx 16rpx;
  color: #1d4ed8;
  font-size: 23rpx;
  background: #eff6ff;
  border-radius: 10rpx;
}

.admin-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  margin-top: 22rpx;
  gap: 12rpx;
}

.mini-button {
  height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  color: #ffffff;
  font-size: 23rpx;
  line-height: 64rpx;
  background: #2563eb;
  border-radius: 12rpx;
}

.detail-button {
  color: #475569;
  background: #f1f5f9;
}

.confirm-button {
  background: #2563eb;
}

.complete-button {
  background: #079455;
}

.cancel-button {
  color: #b42318;
  background: #fff1f0;
}

.reply-box {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
}

.reply-title {
  margin-bottom: 12rpx;
  color: #334155;
  font-size: 24rpx;
  font-weight: 700;
}

.reply-existing {
  width: fit-content;
  max-width: 85%;
  margin-bottom: 14rpx;
  padding: 14rpx 16rpx;
  font-size: 23rpx;
  line-height: 1.6;
  background: #eff6ff;
  border-radius: 10rpx;
}
.reply-existing.reply-own { margin-left:auto;background:#2563eb;color:#ffffff;border-top-right-radius:4rpx; }
.reply-existing.reply-other { margin-right:auto;background:#ffffff;border:1rpx solid #dbeafe;border-top-left-radius:4rpx; }
.reply-own .reply-existing-label,.reply-own .reply-existing-content { color:#ffffff; }
.reply-other .reply-existing-label { color:#1d4ed8; }
.reply-preview-image { display:block;max-width:100%;width:240rpx;border-radius:10rpx;margin-top:10rpx; }

.reply-existing-label {
  color: #1d4ed8;
  font-weight: 600;
}

.reply-existing-content {
  color: #334155;
}

.reply-input {
  box-sizing: border-box;
  width: 100%;
  height: 140rpx;
  padding: 18rpx;
  font-size: 25rpx;
  background: #ffffff;
  border: 1rpx solid #dbe3ef;
  border-radius: 12rpx;
}

.reply-button {
  margin-top: 0;
}

.demo-button {
  margin-top: 34rpx;
}

/* ===== 成员管理 ===== */
.directory-list { padding: 0 26rpx; }
.directory-row { padding: 26rpx 0; border-bottom: 1rpx solid #e8edf5; }
.directory-row:last-child { border-bottom: none; }
.directory-name-row { display: flex; gap: 12rpx; align-items: center; }
.directory-name { color: #1e293b; font-size: 28rpx; font-weight: 600; flex: 1; min-width: 0; overflow-wrap: anywhere; }
.directory-self { color: #2563eb; background: #eff6ff; border-radius: 8rpx; padding: 4rpx 10rpx; font-size: 21rpx; }
.directory-arrow { color: #94a3b8; font-size: 38rpx; }
.directory-meta { color: #64748b; font-size: 23rpx; line-height: 1.6; margin-top: 10rpx; }
.request-pending-tag { display: inline-block; margin-top: 10rpx; padding: 5rpx 12rpx; background: #fff7ed; color: #b45309; border-radius: 8rpx; font-size: 21rpx; }
.profile-heading, .member-summary-top, .member-group-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.profile-name { margin: 22rpx 0 12rpx; font-size: 32rpx; font-weight: 700; color: #1e293b; }
.self-profile-card > .member-meta { margin-top: 16rpx; line-height: 1.7; }
.profile-error { margin: 16rpx 0; padding: 18rpx; color: #b42318; background: #fff1f0; border-radius: 12rpx; font-size: 23rpx; line-height: 1.65; }
.member-stat-row { display: flex; justify-content: space-between; margin: 24rpx 0 20rpx; text-align: center; gap: 12rpx; }
.member-stat-row > view { flex: 1; }
.member-stat-value { display: block; color: #2563eb; font-size: 36rpx; font-weight: 800; }
.member-stat-label { display: block; color: #64748b; font-size: 22rpx; margin-top: 8rpx; }
.member-refresh { margin: 0; padding: 0 14rpx; font-size: 24rpx; line-height: 56rpx; color: #2563eb; background: #eff6ff; border-radius: 10rpx; }
.member-group-heading { margin: 10rpx 4rpx 18rpx; font-size: 27rpx; font-weight: 700; color: #334155; }
.member-group-count { color: #64748b; font-size: 23rpx; font-weight: 400; }
.member-tag-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }
.display-tag, .business-tag, .member-inactive { display: inline-block; padding: 6rpx 14rpx; border-radius: 8rpx; font-size: 21rpx; }
.display-tag { color: #1d4ed8; background: #eff6ff; }
.business-tag { color: #64748b; background: #f1f5f9; }
.member-inactive { color: #b42318; background: #fff1f0; }
.member-load-note { margin: 0 4rpx 18rpx; font-size: 23rpx; line-height: 1.6; color: #64748b; }
.edit-readonly { flex: 1; color: #64748b; font-size: 24rpx; }
.member-edit .edit-input { min-width: 0; }
.member-edit .edit-row > picker { flex: 1; min-width: 0; }
.member-card {
  padding: 24rpx;
}

.member-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.member-name {
  margin-bottom: 6rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.member-openid {
  color: #94a3b8;
  font-size: 20rpx;
  word-break: break-all;
}

.member-role-pill {
  padding: 6rpx 18rpx;
  font-size: 21rpx;
  border-radius: 999rpx;
}

.role-admin {
  color: #ffffff;
  background: #2563eb;
}

.role-leader {
  color: #7c3aed;
  background: #ede9fe;
}

.role-member {
  color: #0f766e;
  background: #ccfbf1;
}

.member-meta {
  margin-bottom: 6rpx;
  color: #64748b;
  font-size: 23rpx;
}

.member-edit {
  margin-top: 18rpx;
  padding: 18rpx;
  background: #f8fafc;
  border-radius: 14rpx;
}

.edit-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  gap: 16rpx;
}

.edit-label {
  width: 160rpx;
  flex-shrink: 0;
  color: #475569;
  font-size: 24rpx;
}

.edit-input {
  flex: 1;
  padding: 14rpx 16rpx;
  font-size: 24rpx;
  background: #ffffff;
  border: 1rpx solid #dbe3ef;
  border-radius: 10rpx;
}

.edit-picker {
  flex: 1;
  padding: 14rpx 16rpx;
  font-size: 24rpx;
  color: #1e293b;
  background: #ffffff;
  border: 1rpx solid #dbe3ef;
  border-radius: 10rpx;
}

.member-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  gap: 12rpx;
}

/* ===== 分配预约弹窗 ===== */
.assign-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.assign-dialog {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 28rpx;
  box-sizing: border-box;
  width: 92%;
  max-width: 720rpx;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
}

.assign-title {
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
  margin-bottom: 8rpx;
  color: #1e293b;
}

.assign-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  gap: 20rpx;
}

.assign-label {
  width: 140rpx;
  flex-shrink: 0;
  color: #64748b;
  font-size: 26rpx;
}

.assign-picker {
  flex: 1;
  padding: 18rpx;
  background: #f8fafc;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #1e293b;
  border: 1rpx solid #e2e8f0;
}

.assign-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  gap: 20rpx;
}
.assign-hint { font-size: 24rpx; color: #64748b; text-align: center; margin-bottom: 18rpx; }
.assign-team { background: #eff6ff; border: 1rpx solid #dbeafe; border-radius: 12rpx; padding: 16rpx; flex-shrink: 0; }
.assign-team-heading { font-size: 25rpx; color: #1e40af; font-weight: 700; margin-bottom: 8rpx; }
.assign-selection { display: flex; align-items: center; gap: 12rpx; padding: 7rpx 0; font-size: 25rpx; }
.assign-selection-role { color: #2563eb; flex-shrink: 0; width: 118rpx; }
.assign-selection-person { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.assign-selection-person text { display: block; }
.assign-meta { font-size: 22rpx; color: #64748b; margin-top: 4rpx; }
.assign-unavailable, .assign-unavailable .assign-meta { color: #b45309; }
.assign-remove { margin: 0; padding: 0 12rpx; font-size: 22rpx; line-height: 48rpx; color: #475569; background: #fff; flex-shrink: 0; }
.assign-tabs { width: 100%; white-space: nowrap; margin: 18rpx 0 10rpx; flex-shrink: 0; }
.assign-tab { display: inline-block; padding: 12rpx 18rpx; margin-right: 10rpx; font-size: 24rpx; background: #f1f5f9; color: #475569; border-radius: 10rpx; }
.assign-tab-active { background: #2563eb; color: #fff; }
.assign-members { height: 32vh; min-height: 160rpx; flex-shrink: 1; }
.assign-member { padding: 18rpx 0; border-bottom: 1rpx solid #e2e8f0; }
.assign-member-heading { display: flex; align-items: center; gap: 10rpx; }
.assign-role { font-size: 20rpx; padding: 3rpx 8rpx; background: #f1f5f9; border-radius: 6rpx; color: #475569; flex-shrink: 0; }
.assign-member-name { font-size: 27rpx; color: #1e293b; overflow-wrap: anywhere; }
.assign-person-actions { display: flex; gap: 12rpx; margin-top: 12rpx; }
.assign-person-button { flex: 1; margin: 0; padding: 0 8rpx; font-size: 23rpx; line-height: 58rpx; color: #2563eb; background: #eff6ff; border: 1rpx solid #dbeafe; }
.assign-person-button.assign-selected { background: #2563eb; color: #fff; }
.assign-person-button[disabled] { background: #f1f5f9; color: #94a3b8; border-color: #e2e8f0; }
.assign-error { color: #b45309; background: #fffbeb; border-radius: 8rpx; padding: 12rpx; font-size: 24rpx; margin-bottom: 8rpx; flex-shrink: 0; }
.assign-state { text-align: center; color: #64748b; font-size: 25rpx; padding: 24rpx 0; }
.assign-retry { font-size: 25rpx; color: #2563eb; background: #eff6ff; }
.assign-actions .mini-button { flex: 1; margin: 0; }

.void-reason{margin-top:18rpx;padding:16rpx;background:#fff1f2;color:#9f1239;font-size:24rpx;border-radius:12rpx;line-height:1.6}.special-button{background:#f1f5f9!important;color:#475569!important}
