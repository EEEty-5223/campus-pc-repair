/* ===== 分配预约弹窗 ===== */
.assign-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.assign-dialog {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 28rpx;
  box-sizing: border-box;
  width: 92%;
  max-width: 720rpx;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
}

.assign-title {
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
  margin-bottom: 8rpx;
  color: #1e293b;
}

.assign-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  gap: 20rpx;
}

.assign-label {
  width: 140rpx;
  flex-shrink: 0;
  color: #64748b;
  font-size: 26rpx;
}

.assign-picker {
  flex: 1;
  padding: 18rpx;
  background: #f8fafc;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #1e293b;
  border: 1rpx solid #e2e8f0;
}

.assign-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  gap: 20rpx;
}
.assign-hint { font-size: 24rpx; color: #64748b; text-align: center; margin-bottom: 18rpx; }
.assign-team { background: var(--color-primary-soft, #edf8f4); border: 1rpx solid var(--color-primary-tint, #dcf4eb); border-radius: 12rpx; padding: 16rpx; flex-shrink: 0; }
.assign-team-heading { font-size: 25rpx; color: #076d69; font-weight: 700; margin-bottom: 8rpx; }
.assign-selection { display: flex; align-items: center; gap: 12rpx; padding: 7rpx 0; font-size: 25rpx; }
.assign-selection-role { color: var(--color-primary, #0b8f89); flex-shrink: 0; width: 118rpx; }
.assign-selection-person { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.assign-selection-person text { display: block; }
.assign-meta { font-size: 22rpx; color: #64748b; margin-top: 4rpx; }
.assign-unavailable, .assign-unavailable .assign-meta { color: #b45309; }
.assign-remove { margin: 0; padding: 0 12rpx; font-size: 22rpx; line-height: 48rpx; color: #475569; background: #fff; flex-shrink: 0; }
.assign-tabs { width: 100%; white-space: nowrap; margin: 18rpx 0 10rpx; flex-shrink: 0; }
.assign-tab { display: inline-block; padding: 12rpx 18rpx; margin-right: 10rpx; font-size: 24rpx; background: #f1f5f9; color: #475569; border-radius: 10rpx; }
.assign-tab-active { background: var(--color-primary, #0b8f89); color: #fff; }
.assign-members { height: 32vh; min-height: 160rpx; flex-shrink: 1; }
.assign-member { padding: 18rpx 0; border-bottom: 1rpx solid #e2e8f0; }
.assign-member-heading { display: flex; align-items: center; gap: 10rpx; }
.assign-role { font-size: 20rpx; padding: 3rpx 8rpx; background: #f1f5f9; border-radius: 6rpx; color: #475569; flex-shrink: 0; }
.assign-member-name { font-size: 27rpx; color: #1e293b; overflow-wrap: anywhere; }
.assign-person-actions { display: flex; gap: 12rpx; margin-top: 12rpx; }
.assign-person-button { flex: 1; margin: 0; padding: 0 8rpx; font-size: 23rpx; line-height: 58rpx; color: var(--color-primary, #0b8f89); background: var(--color-primary-soft, #edf8f4); border: 1rpx solid var(--color-primary-tint, #dcf4eb); }
.assign-person-button.assign-selected { background: var(--color-primary, #0b8f89); color: #fff; }
.assign-person-button[disabled] { background: #f1f5f9; color: #94a3b8; border-color: #e2e8f0; }
.assign-error { color: #b45309; background: #fffbeb; border-radius: 8rpx; padding: 12rpx; font-size: 24rpx; margin-bottom: 8rpx; flex-shrink: 0; }
.assign-state { text-align: center; color: #64748b; font-size: 25rpx; padding: 24rpx 0; }
.assign-retry { font-size: 25rpx; color: var(--color-primary, #0b8f89); background: var(--color-primary-soft, #edf8f4); }
.assign-actions .mini-button { flex: 1; margin: 0; }

.void-reason{margin-top:18rpx;padding:16rpx;background:#fff1f2;color:#9f1239;font-size:24rpx;border-radius:12rpx;line-height:1.6}.special-button{background:#f1f5f9!important;color:#475569!important}


/* 一排保留主操作，特殊操作收入底部菜单。显式覆盖原生button默认宽度。 */
.admin-actions.compact-actions { display: flex; flex-wrap: nowrap; align-items: center; gap: 8rpx; padding-top: 18rpx; border-top: 1rpx solid #e8f0eb; }
.compact-actions .card-text-action { flex: 0 0 auto; width: auto; min-width: 0; margin: 0; padding: 0 12rpx; height: 68rpx; line-height: 68rpx; color: #64748b; background: transparent; font-size: 25rpx; }
.compact-actions .card-primary-action { flex: 1; width: auto; min-width: 0; max-width: 250rpx; margin: 0 0 0 auto; padding: 0 18rpx; height: 72rpx; line-height: 72rpx; border-radius: 14rpx; background: var(--color-primary, #0b8f89); color: white; font-size: 26rpx; }
.compact-actions button::after, .reply-link::after, .quick-send::after, .card-menu-sheet button::after { border: 0; }
.compact-actions .card-primary-action[disabled] { color: #94a3b8; background: #e8f0eb; }
.reply-entry-actions { display: flex; justify-content: flex-end; gap: 20rpx; margin-top: 10rpx; }
.reply-entry-actions .reply-link { width: auto; margin: 0; padding: 4rpx 0; color: var(--color-primary, #0b8f89); background: transparent; font-size: 24rpx; line-height: 52rpx; }
.reply-box .quick-send { width: auto; margin: 12rpx 0 0 auto; padding: 0 24rpx; height: 64rpx; line-height: 64rpx; color: white; background: var(--color-primary, #0b8f89); font-size: 24rpx; border-radius: 12rpx; }
.reply-existing-content { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.card-menu-mask { position: fixed; z-index: 1100; inset: 0; display: flex; align-items: flex-end; background: rgba(15,23,42,.4); }
.card-menu-sheet { width: 100%; box-sizing: border-box; padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); background: #fff; border-radius: 28rpx 28rpx 0 0; max-height: 85vh; overflow-y: auto; }
.card-menu-title { color: #64748b; font-size: 25rpx; text-align: center; padding: 4rpx 0 18rpx; }
.card-menu-sheet .card-menu-option { width: 100%; margin: 0; padding: 0; background: #fff; color: #172033; font-size: 29rpx; line-height: 88rpx; border-bottom: 1rpx solid #f1f5f9; border-radius: 0; }
.card-menu-sheet .card-menu-danger { color: #dc2626; }
.card-menu-sheet .card-menu-cancel { width: 100%; margin: 18rpx 0 0; color: #64748b; background: #f1f5f9; line-height: 80rpx; font-size: 27rpx; border-radius: 16rpx; }
