/* ===== Tab 切换栏 ===== */
.tab-bar {
  display: flex;
  margin-bottom: 28rpx;
  padding: 8rpx;
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
}

.tab-item {
  position: relative;
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  color: #64748b;
  font-size: 26rpx;
  font-weight: 600;
}

.tab-active {
  color: #ffffff;
  background: #2563eb;
  border-radius: 12rpx;
}

.tab-badge {
  display: inline-block;
  margin-left: 8rpx;
  padding: 2rpx 12rpx;
  color: #ffffff;
  font-size: 20rpx;
  background: #ef4444;
  border-radius: 999rpx;
}

.reply-actions {
  display: flex;
  margin-top: 14rpx;
  gap: 12rpx;
}

/* ===== 邀请码管理 ===== */
.invite-action-card {
  text-align: center;
}

.invite-action-title {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.invite-action-desc {
  margin-bottom: 24rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.6;
}

.generate-button {
  height: 80rpx;
  margin: 0;
  padding: 0 40rpx;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 80rpx;
  background: #2563eb;
  border-radius: 14rpx;
}

.invite-card {
  padding: 24rpx;
}

.invite-code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.invite-code-text {
  font-size: 32rpx;
  font-weight: 800;
  color: #1e293b;
  letter-spacing: 2rpx;
}

.invite-status-pill {
  padding: 6rpx 18rpx;
  font-size: 21rpx;
  border-radius: 999rpx;
}

.invite-status-valid {
  color: #ffffff;
  background: #079455;
}

.invite-status-used {
  color: #475569;
  background: #f1f5f9;
}

.invite-status-expired {
  color: #b42318;
  background: #fef2f2;
}

.invite-meta {
  margin-bottom: 6rpx;
  color: #64748b;
  font-size: 22rpx;
}

.copy-btn {
  margin-top: 14rpx;
}

.primary-button {
  color: #ffffff;
  background: #2563eb;
}

/* ===== 申请审核 ===== */
.apply-card {
  padding: 24rpx;
}

.apply-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.apply-name {
  margin-bottom: 6rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.apply-dept {
  color: #64748b;
  font-size: 23rpx;
}

.apply-status-pill {
  padding: 6rpx 18rpx;
  font-size: 21rpx;
  border-radius: 999rpx;
}

.apply-status-pending {
  color: #b45309;
  background: #fef3c7;
}

.apply-status-approved {
  color: #ffffff;
  background: #079455;
}

.apply-status-rejected {
  color: #b42318;
  background: #fef2f2;
}

.apply-meta {
  margin-bottom: 6rpx;
  color: #64748b;
  font-size: 22rpx;
}

.apply-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
  gap: 12rpx;
}

.demo-warning {
  margin-bottom: 30rpx;
  padding: 24rpx;
  color: #7c2d12;
  font-size: 23rpx;
  line-height: 1.65;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  border-radius: 18rpx;
}

.warning-title {
  margin-bottom: 8rpx;
  font-weight: 700;
}

.admin-head,
.admin-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.admin-head {
  margin: 4rpx 4rpx 24rpx;
}

.admin-title {
  font-size: 38rpx;
  font-weight: 800;
}

.admin-count {
  color: #64748b;
  font-size: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-bottom: 26rpx;
  gap: 16rpx;
}

.stat-card {
  padding: 24rpx 12rpx;
  color: #1d4ed8;
  text-align: center;
  background: #eff6ff;
  border-radius: 18rpx;
}

.active-stat {
  color: #7e22ce;
  background: #faf5ff;
}

.completed-stat {
  color: #067647;
  background: #ecfdf3;
}

.stat-value {
  font-size: 38rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.filter-scroll {
  width: 100%;
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  padding: 2rpx 2rpx 8rpx;
  gap: 14rpx;
}

.filter-chip {
  display: inline-flex;
  padding: 14rpx 24rpx;
  color: #64748b;
  font-size: 23rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 999rpx;
}

.filter-chip-active {
  color: #ffffff;
  background: #2563eb;
  border-color: #2563eb;
}

.customer-name {
  margin-bottom: 8rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.customer-phone {
  color: #64748b;
  font-size: 23rpx;
}

.fault-summary {
  margin: 24rpx 0 14rpx;
  color: #334155;
  font-size: 25rpx;
  line-height: 1.6;
}

.schedule {
  padding: 18rpx;
  color: #475569;
  font-size: 23rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

.admin-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  margin-top: 22rpx;
  gap: 12rpx;
}

.mini-button {
  height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  color: #ffffff;
  font-size: 23rpx;
  line-height: 64rpx;
  background: #2563eb;
  border-radius: 12rpx;
}

.detail-button {
  color: #475569;
  background: #f1f5f9;
}

.confirm-button {
  background: #2563eb;
}

.complete-button {
  background: #079455;
}

.cancel-button {
  color: #b42318;
  background: #fff1f0;
}

.reply-box {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
}

.reply-title {
  margin-bottom: 12rpx;
  color: #334155;
  font-size: 24rpx;
  font-weight: 700;
}

.reply-existing {
  margin-bottom: 14rpx;
  padding: 14rpx 16rpx;
  font-size: 23rpx;
  line-height: 1.6;
  background: #eff6ff;
  border-radius: 10rpx;
}

.reply-existing-label {
  color: #1d4ed8;
  font-weight: 600;
}

.reply-existing-content {
  color: #334155;
}

.reply-input {
  box-sizing: border-box;
  width: 100%;
  height: 140rpx;
  padding: 18rpx;
  font-size: 25rpx;
  background: #ffffff;
  border: 1rpx solid #dbe3ef;
  border-radius: 12rpx;
}

.reply-button {
  margin-top: 0;
}

.demo-button {
  margin-top: 34rpx;
}
