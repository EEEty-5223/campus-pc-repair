@import "../../utils/portal.wxss";
.article-paper{background:white;border-radius:24rpx;padding:34rpx 30rpx}.article-title{font-size:42rpx;font-weight:800;line-height:1.55;margin-top:18rpx}.article-category{font-size:24rpx;color:var(--color-primary-strong, #087f7b)}.article-cover{margin-top:30rpx}.article-summary{background:#f3f8f9;border-left:5rpx solid #77cfc7;padding:22rpx;margin-top:32rpx;font-size:27rpx;color:#6c838d;line-height:1.9}.article-block{font-size:29rpx;line-height:2;white-space:pre-wrap;word-break:break-word;margin-top:30rpx;color:#394d5c}.article-heading{font-weight:700;font-size:33rpx;color:#1c4349}.article-image{width:100%;margin-top:26rpx;border-radius:12rpx}.article-end{text-align:center;color:#a4b0ba;font-size:22rpx;margin:55rpx 0 20rpx}.article-actions{display:flex;gap:18rpx}.article-actions button{flex:1;font-size:25rpx;line-height:74rpx}
