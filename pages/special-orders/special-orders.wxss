.review-heading,.review-top{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.heading-title{font-size:40rpx;font-weight:700}.count{font-size:24rpx;color:#64748b}.count-pending{color:#dc2626}.scope-note{font-size:25rpx;line-height:1.8;color:#64748b;margin:18rpx 0 26rpx}.review-filters{display:flex;gap:14rpx;margin-bottom:24rpx}.filter{flex:1;margin:0;padding:16rpx 0;line-height:1.5;border-radius:16rpx;font-size:26rpx;background:#fff;color:#64748b}.filter.selected{background:var(--color-primary, #0b8f89);color:white}.state{text-align:center;color:#64748b;line-height:1.8}.state button{margin-top:22rpx}.job-title{font-size:29rpx;font-weight:700;flex:1;min-width:0;word-break:break-all}.review-status{font-size:22rpx;flex-shrink:0;padding:8rpx 14rpx;border-radius:999rpx;background:#f1f5f9;color:#475569}.review-status.pending{color:#b45309;background:#fffbeb}.review-status.approved{color:#15803d;background:#f0fdf4}.review-status.rejected{color:#b42318;background:#fff1f0}.meta{font-size:24rpx;color:#64748b;line-height:1.8;margin-top:12rpx;word-break:break-all}.reason{font-size:27rpx;padding:20rpx;border-radius:14rpx;background:#fff7ed;color:#92400e;margin-top:22rpx}.review-actions{display:flex;justify-content:flex-end;flex-wrap:wrap;gap:12rpx;margin-top:24rpx}.small-button{margin:0;padding:0 20rpx;line-height:64rpx;border-radius:14rpx;background:var(--color-primary-soft, #edf8f4);color:var(--color-primary, #0b8f89);font-size:24rpx}.reject-button{color:#b42318;background:#fff1f0}.approve-button{background:var(--color-primary, #0b8f89);color:white}
