.title{font-size:32rpx;font-weight:700;line-height:1.5}.hint{margin-top:14rpx;color:#64748b;font-size:25rpx;line-height:1.7}.steps{display:flex;justify-content:center;gap:22rpx;margin:4rpx 0 28rpx;color:#94a3b8;font-size:25rpx}.step-active{color:#2563eb;font-weight:700}.photo-grid{display:flex;flex-wrap:wrap;gap:16rpx;margin:26rpx 0}.photo-cell,.add-photo{position:relative;width:174rpx;height:174rpx;border-radius:16rpx;overflow:hidden}.photo-cell image{width:100%;height:100%}.add-photo{margin:0;padding:0;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1.6;font-size:23rpx;color:#2563eb;background:#eff6ff;border:1rpx dashed #93b4f5}.plus{font-size:48rpx}.remove-photo{position:absolute;top:0;right:0;margin:0;padding:0;width:44rpx;height:44rpx;line-height:40rpx;border-radius:0 0 0 12rpx;background:rgba(15,23,42,.7);color:white;font-size:34rpx}.uploaded{position:absolute;bottom:0;left:0;right:0;padding:6rpx;background:rgba(15,23,42,.55);color:white;text-align:center;font-size:20rpx}.note-input{box-sizing:border-box;width:100%;height:160rpx;padding:20rpx;margin-bottom:26rpx;border:1rpx solid #dce4f0;border-radius:16rpx;font-size:27rpx;background:#f8fafc}.skip-photo{margin:18rpx 0 0;padding:8rpx;background:transparent;color:#64748b;line-height:1.7;font-size:25rpx}.error{margin:18rpx 0;color:#b42318;font-size:25rpx;line-height:1.6}.evidence-note{margin:22rpx 0;padding:20rpx;background:#eff6ff;border-radius:14rpx;color:#1d4ed8;line-height:1.7;font-size:25rpx}.exception-note{background:#fff7ed;color:#9a6700}.code-input{box-sizing:border-box;width:100%;height:104rpx;padding:16rpx;text-align:center;border:2rpx solid #bfdbfe;border-radius:16rpx;font-size:40rpx;letter-spacing:12rpx;background:#f8fafc}.submit-button{margin-top:28rpx}.state{text-align:center;color:#64748b;line-height:1.8}.state button{margin-top:24rpx}.success-card{text-align:center}.success-symbol{font-size:72rpx;color:#16a34a;margin:20rpx}.success-card .primary-button{marg