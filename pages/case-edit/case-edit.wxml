<view class="portal-page">
  <view class="portal-title">{{previewing ? '案例预览' : '整理维修案例'}}</view><view class="portal-subtitle">{{previewing ? '核对用户将看到的文字与图片。' : '维修人员与时间来自预约记录，公开内容由你整理。'}}</view>
  <view wx:if="{{error}}" class="portal-tip">{{error}}<button class="portal-secondary" bindtap="reload" disabled="{{busy || loading}}">重新加载</button></view><view wx:if="{{loading && !item}}" class="portal-state">正在加载…</view>
  <block wx:if="{{item}}">
    <view wx:if="{{!sourceAvailable || !caseImagesReady}}" class="portal-tip">原预约已作废、重开或尚未通过审核，案例暂不可公开。</view>
    <view wx:if="{{item.status === 'published'}}" class="portal-tip">案例已发布。修改文字和图片前，请先撤下。<button wx:if="{{canPublish}}" class="portal-secondary" bindtap="withdraw" disabled="{{busy || loading}}">撤下并编辑</button></view>
    <view class="portal-card"><view class="case-person">{{item.technicianNames}}<text class="case-department">{{item.department}}</text></view><view class="case-kind">{{item.faultType}}</view><view class="case-time">预约时间 · {{item.appointmentTime}}</view><view class="case-time">完成时间 · {{item.completedText}}</view></view>
    <block wx:if="{{!previewing}}">
      <view class="portal-label">案例标题</view><input class="portal-input" value="{{form.title}}" maxlength="80" data-field="title" bindinput="input" disabled="{{!canEdit || busy}}" placeholder="一句话概括本次维修"/>
      <view class="portal-label">公开维修地点</view><input class="portal-input" value="{{form.publicLocation}}" maxlength="80" data-field="publicLocation" bindinput="input" disabled="{{!canEdit || busy}}" placeholder="填写校区或楼宇，不填房间号"/>
      <view class="portal-label">故障现象</view><textarea class="portal-textarea case-small-textarea" value="{{form.symptoms}}" maxlength="2000" data-field="symptoms" bindinput="input" disabled="{{!canEdit || busy}}" placeholder="说明故障现象，避免粘贴报修人的个人信息"/>
      <view class="portal-label">处理方式</view><textarea class="portal-textarea" value="{{form.solution}}" maxlength="3000" data-field="solution" bindinput="input" disabled="{{!canEdit || busy}}" placeholder="检测过程、确认的原因与处理方式"/>
      <view class="portal-label">处理结果</view><textarea class="portal-textarea case-small-textarea" value="{{form.result}}" maxlength="300" data-field="result" bindinput="input" disabled="{{!canEdit || busy}}" placeholder="例如已修复、完成清灰，或建议更换配件"/>
    </block>
    <block wx:else><view class="portal-section">{{form.title}}</view><view class="case-location">维修地点 · {{form.publicLocation || '尚未填写'}}</view><view class="portal-section">遇到了什么问题</view><view class="case-content">{{form.symptoms || '尚未填写'}}</view><view class="portal-section">我们怎样处理</view><view class="case-content">{{form.solution || '尚未填写'}}</view><view class="portal-section">处理结果</view><view class="case-result">{{form.result || '尚未填写'}}</view></block>
    <view class="portal-section">案例图片 {{photos.length}} / 9</view><view class="case-caption" wx:if="{{!previewing}}">检查图片中是否包含姓名、联系方式、序列号或私人文件；发布前可重新拍摄处理后的图片。</view>
    <view class="case-grid"><view class="case-image-cell" wx:for="{{photos}}" wx:key="id"><image wx:if="{{item.displayUrl}}" src="{{item.displayUrl}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{item.displayUrl}}" data-id="{{item.id}}" binderror="imageFailed"/><view wx:else class="case-caption">图片暂未加载</view><button wx:if="{{canEdit && !previewing}}" bindtap="removePhoto" data-id="{{item.id}}" disabled="{{busy || loading}}">移除</button></view></view>
    <button wx:if="{{canEdit && !previewing && photos.length < 9}}" class="portal-secondary" bindtap="choosePhoto" disabled="{{busy || loading}}" loading="{{busy}}">选择案例图片</button>
    <block wx:if="{{canEdit && !previewing && sourcePhotos.length}}"><view class="portal-section">原预约完工照片</view><view class="case-caption">选中后会复制为案例图片，原完工资料保留。</view><view class="case-grid"><view class="case-image-cell" wx:for="{{sourcePhotos}}" wx:key="id"><image wx:if="{{item.displayUrl}}" src="{{item.displayUrl}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{item.displayUrl}}" data-id="{{item.id}}" binderror="imageFailed"/><view wx:else class="case-caption">图片暂未加载</view><button class="import-image" bindtap="importPhoto" data-id="{{item.id}}" disabled="{{busy || loading || photos.length >= 9}}">用于案例</button></view></view></block>
    <view wx:if="{{imageError}}" class="portal-tip" bindtap="reload">部分图片未能显示，点击重新加载</view>
    <view wx:if="{{canEdit}}" class="case-actions"><button class="portal-secondary" bindtap="{{previewing ? 'edit' : 'preview'}}" disabled="{{busy || loading}}">{{previewing ? '继续编辑' : '预览案例'}}</button><button class="portal-secondary" bindtap="saveDraft" disabled="{{busy || loading || stale}}" loading="{{busy}}">保存草稿</button></view>
    <block wx:if="{{canEdit && canPublish && previewing}}"><checkbox-group bindchange="confirm"><label class="case-confirm"><checkbox value="confirmed" checked="{{confirmed}}" color="#0b8f89"/><text>我已核对维修人员、公开地点、文字和图片，确认适合公开展示且不包含报修人的个人信息。</text></label></checkbox-group><button class="portal-primary" bindtap="publish" disabled="{{!confirmed || busy || loading || stale || !sourceAvailable || !caseImagesReady}}" loading="{{busy}}">确认发布</button></block>
    <view wx:if="{{canEdit && !canPublish}}" class="case-caption">负责人可整理草稿，发布由管理员处理。</view><button wx:if="{{canEdit && !previewing}}" class="portal-secondary" bindtap="removeDraft" disabled="{{busy || loading}}">删除草稿</button>
  </block>
</view>
