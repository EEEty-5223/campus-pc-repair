.home-page {
  padding-top: 24rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  padding: 48rpx 40rpx 38rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 55%, #38bdf8 135%);
  border-radius: 32rpx;
  box-shadow: 0 18rpx 45rpx rgba(37, 99, 235, 0.22);
}

.hero::after {
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 300rpx;
  height: 300rpx;
  content: '';
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.hero-badge {
  display: inline-flex;
  position: relative;
  z-index: 1;
  padding: 10rpx 20rpx;
  font-size: 23rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 999rpx;
}

.hero-title {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.28;
}

.hero-desc {
  position: relative;
  z-index: 1;
  margin: 18rpx 0 34rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 27rpx;
  line-height: 1.6;
}

.hero-button {
  position: relative;
  z-index: 1;
  height: 88rpx;
  color: #1d4ed8;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 0;
  text-align: center;
}

.hero-record {
  position: relative;
  z-index: 1;
  padding-top: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 24rpx;
  text-align: center;
}

.service-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  gap: 20rpx;
}

.service-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 300rpx;
  margin: 0;
  padding: 26rpx 24rpx;
  color: #172033;
  line-height: 1.5;
  text-align: left;
  background: #ffffff;
  border: 1rpx solid #e8edf5;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(31, 53, 90, 0.035);
  white-space: normal;
  overflow-wrap: break-word;
  transition: background 0.15s, border-color 0.15s, transform 0.15s;
}

.service-card-pressed {
  background: #eff6ff;
  border-color: #93c5fd;
  transform: translateY(2rpx);
}

.service-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 20rpx;
  color: #2563eb;
  font-size: 23rpx;
  font-weight: 600;
}

.service-arrow {
  font-size: 32rpx;
  line-height: 1;
}

.record-retry {
  position: relative;
  z-index: 1;
  width: auto;
  margin: 12rpx auto 0;
  padding: 8rpx 20rpx;
  color: #ffffff;
  font-size: 23rpx;
  line-height: 1.5;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
}

.record-retry-pressed {
  background: rgba(255, 255, 255, 0.25);
}

.service-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 18rpx;
  background: #eff6ff;
  border-radius: 20rpx;
  font-size: 42rpx;
  line-height: 1;
}

.service-name {
  margin-bottom: 8rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.service-desc {
  min-width: 0;
  min-height: 69rpx;
  color: #64748b;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 1.5;
}

.process-card {
  padding: 12rpx 30rpx;
}

.process-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #edf1f7;
}

.process-item:last-child {
  border-bottom: 0;
}

.step-number {
  display: flex;
  flex: 0 0 56rpx;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: 24rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  background: #2563eb;
  border-radius: 50%;
}

.step-title {
  margin-bottom: 5rpx;
  font-weight: 700;
}

.step-desc {
  color: #64748b;
  font-size: 24rpx;
}

.notice {
  margin-top: 34rpx;
  background: #fffbeb;
  border-color: #fde68a;
  box-shadow: none;
}

.notice-title {
  margin-bottom: 16rpx;
  color: #92400e;
  font-weight: 700;
}

.notice-line {
  margin-top: 8rpx;
  color: #78350f;
  font-size: 24rpx;
  line-height: 1.65;
}

.consult-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 30rpx;
  margin-top: 28rpx;
  background: linear-gradient(135deg, #eff6ff 0%, #ffffff 100%);
  border: 1rpx solid #dbeafe;
}

.consult-entry-main {
  flex: 1;
}

.consult-entry-title {
  margin-bottom: 10rpx;
  color: #1d4ed8;
  font-size: 32rpx;
  font-weight: 700;
}

.consult-entry-desc {
  color: #64748b;
  font-size: 24rpx;
}

.consult-entry-arrow {
  flex: 0 0 auto;
  color: #2563eb;
  font-size: 44rpx;
  font-weight: 300;
}

.admin-entry {
  padding: 20rpx 0 8rpx;
  color: #64748b;
  font-size: 24rpx;
  text-align: center;
}

.apply-entry {
  color: #2563eb;
  font-weight: 600;
}

.unread-badge { display: inline-flex; align-items: center; justify-content: center; min-width: 34rpx; height: 34rpx; margin-left: 12rpx; padding: 0 9rpx; box-sizing: border-box; border-radius: 18rpx; background: #ef4444; color: #fff; font-size: 22rpx; line-height: 34rpx; vertical-align: middle; }
