@import "../../utils/portal.wxss";
.my-page{background:var(--color-page, #f3f8f6);min-height:100vh}.my-header{background:linear-gradient(155deg,#0ca9a9 0%,#34bfbb 55%,#bbeae6 100%);padding:42rpx 30rpx 110rpx;color:#fff;min-height:230rpx}.my-brand{font-size:24rpx;letter-spacing:3rpx;opacity:.85}.my-profile{display:flex;align-items:center;margin-top:46rpx;gap:22rpx}.my-avatar{flex-shrink:0;width:120rpx;height:120rpx;border:5rpx solid rgba(255,255,255,.8);border-radius:50%;background:#ddf7f5}.my-avatar-default{display:flex;align-items:center;justify-content:center}.my-avatar-default image{width:80rpx;height:80rpx}.my-person{flex:1;min-width:0}.my-name{font-size:38rpx;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.my-id{font-size:23rpx;opacity:.88;margin-top:9rpx}.my-role{display:inline-block;font-size:21rpx;margin-top:10rpx}.my-edit{padding:0 18rpx;font-size:22rpx;line-height:58rpx;border-radius:36rpx;background:rgba(255,255,255,.2);color:white;margin:0;flex-shrink:0}.my-edit::after{border:0}.my-placeholder{padding:52rpx 0}.my-body{padding:0 28rpx 38rpx}.my-stats{display:flex;gap:20rpx;margin-top:-65rpx;position:relative}.my-stat{flex:1;position:relative;background:#fff;border-radius:26rpx;padding:28rpx 24rpx;min-width:0;overflow:hidden;box-shadow:0 8rpx 28rpx rgba(31,111,111,.05)}.my-stat-value{font-size:52rpx;font-weight:800;color:#223949}.my-stat-label{font-size:24rpx;margin-top:8rpx;color:#667e8c}.my-stat-visual{position:absolute;right:24rpx;top:21rpx;font-size:70rpx;line-height:1;color:#71d1ce;opacity:.65}.favorite-visual{color:#f3bf64}.my-group{background:white;padding:4rpx 24rpx;margin-top:24rpx;border-radius:26rpx;border:1rpx solid #e5eeea}.my-count{font-size:23rpx;color:#94a1ae}.blue-icon{background:var(--color-primary-soft, #edf8f4);color:#238f81}.orange-icon{background:#fff5e8;color:#d99b4d}.pink-icon{background:#fff0f3;color:#d4899c}.gray-icon{background:#f0f3f8;color:#7c90a8}.my-footer{font-size:22rpx;text-align:center;color:#a0adba;padding:35rpx 0 15rpx}
