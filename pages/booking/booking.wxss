.booking-page {
  padding-bottom: 70rpx;
}

.form-intro {
  padding: 14rpx 6rpx 28rpx;
}

.form-intro-title {
  margin-bottom: 10rpx;
  font-size: 40rpx;
  font-weight: 800;
}

.form-intro-desc {
  color: #64748b;
  font-size: 25rpx;
}

.form-card {
  padding: 12rpx 30rpx;
}

.group-title {
  padding: 24rpx 0 10rpx;
  color: #1d4ed8;
  font-size: 25rpx;
  font-weight: 700;
}

.field {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf1f7;
}

.field.no-border {
  border-bottom: 0;
}

.field-label {
  margin-bottom: 16rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.required {
  color: #dc2626;
}

.field-control,
.picker-control {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  padding: 18rpx 22rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
}

.picker-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #334155;
}

.textarea-control {
  box-sizing: border-box;
  width: 100%;
  height: 210rpx;
  padding: 20rpx 22rpx;
  line-height: 1.6;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
}

.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 28rpx 0;
  color: #64748b;
  font-size: 24rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
}

.agreement checkbox {
  margin-right: 6rpx;
  transform: scale(0.78);
}

.privacy-link {
  color: #2563eb;
}

.submit-button {
  width: 100%;
}
