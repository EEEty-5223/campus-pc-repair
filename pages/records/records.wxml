<view class="page records-page" bindtouchstart="onNavigationTouchStart" bindtouchmove="onNavigationTouchMove" bindtouchend="onNavigationTouchEnd" bindtouchcancel="onNavigationTouchCancel">
  <view wx:if="{{subscribeMode}}" class="subscription-picker-tip">请选择一笔进行中的预约，进入详情后点击“订阅一次本单消息”。每次授权只提醒一次。</view>
  <view class="navigation-hint">‹ 顶部右滑返回首页</view>
  <view class="records-head">
    <view>
      <view class="records-title">我的预约（点击查看详细可以对话）</view>
      <view class="records-subtitle">共 {{items.length}} 条本机记录</view>
    </view>
    <button data-swipe-scope="ignore" bindtouchstart="onNavigationTouchStart" class="new-button" bindtap="goBooking">+ 新预约</button>
  </view>

  <view class="swipe-list-area" data-swipe-scope="records" bindtouchstart="onNavigationTouchStart">
  <view class="navigation-hint">左右滑动列表切换分类，也可点击分类</view>
  <view class="record-filters">
    <view
      class="record-filter {{currentFilter === item.value ? 'record-filter-active' : ''}}"
      wx:for="{{filters}}"
      wx:key="value"
      data-filter="{{item.value}}"
      bindtap="selectFilter"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{items.length}}">
    <view class="card record-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="record-top">
        <view class="record-device">{{item.deviceType}}</view>
        <view class="status-pill {{item.statusClass}}">{{item.statusText}}</view>
      </view>
      <view class="record-fault">{{item.faultType}} · {{item.description}}</view>
      <view class="record-meta">
        <view>📅 {{item.appointmentDate}} {{item.timeSlot}}</view>
        <view>📍 {{item.location}}</view>
      </view>
      <view class="record-reply" wx:if="{{item.latestMessage}}">💬 {{item.latestMessage.fromText}}：{{item.latestMessage.content}}</view>
      <view class="record-bottom">
        <text>编号 {{item.id}}</text>
        <text class="detail-link">查看详情 ›</text>
      </view>
    </view>
  </view>

  <view class="card empty-state" wx:else>
    <text class="empty-icon">🧰</text>
    <text class="empty-title">当前分类暂无预约</text>
    <text class="muted">切换分类，或提交一条新的维修预约</text>
    <button data-swipe-scope="ignore" bindtouchstart="onNavigationTouchStart" class="primary-button empty-button" bindtap="goBooking">预约电脑维修</button>
  </view>
  </view>
</view>
